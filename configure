#!/bin/bash

set -euo pipefail

SDIR="srcs"
ODIR="objs"
IDIR="incs"
OUT="objects.mk"

if [ ! -d "$SDIR" ]; then
    echo "configure: erreur, dossier '$SDIR' introuvable" >&2
    exit 1
fi

# --- utilitaires -----------------------------------------------------------

get_local_includes() {
    grep -oE '#[[:space:]]*include[[:space:]]*"[^"]+"' "$1" 2>/dev/null \
        | sed -E 's/.*"([^"]+)".*/\1/'
}

resolve_header_path() {
    local including_file="$1"
    local header_name="$2"

    if [ -f "$IDIR/$header_name" ]; then
        echo "$IDIR/$header_name"
    elif [ -f "$(dirname "$including_file")/$header_name" ]; then
        echo "$(dirname "$including_file")/$header_name"
    fi
}

resolve_headers_recursive() {
    local file="$1"
    local header_name header_path

    for header_name in $(get_local_includes "$file"); do
        header_path="$(resolve_header_path "$file" "$header_name")"

        if [ -n "$header_path" ] && [ -z "${VISITED[$header_path]:-}" ]; then
            VISITED["$header_path"]=1
            resolve_headers_recursive "$header_path"
        fi
    done
}

: > "$OUT"

all_objs=""

while IFS= read -r -d '' src; do
    src_name="$(basename "$src")"
    base="${src_name%.c}"
    obj="\$(ODIR)/$base.o"
    all_objs="$all_objs $obj"

    declare -A VISITED=()
    resolve_headers_recursive "$src"

    deps="\$(SDIR)/$src_name"
    for header_path in "${!VISITED[@]}"; do
        deps="$deps \$(IDIR)/$(basename "$header_path")"
    done

    {
        echo "$obj: $deps"
        printf '\t$(CC) $(CFLAGS) -c $< -o $@\n'
        echo ""
    } >> "$OUT"
done < <(find "$SDIR" -name '*.c' -print0 | sort -z)

echo "OBJS =$all_objs" >> "$OUT"

echo "configure: OK ($OUT created, $(grep -c '^\$(ODIR)' "$OUT") rules)"
